def detect_product_drop(row):
    if (
        pd.isna(row["Sales_Change_pct"]) or
        pd.isna(row["Quantity_Change_pct"])
    ):
        return "Insufficient_Baseline"

    if (
        row["Sales_Change_pct"] <= -30 and
        row["Quantity_Change_pct"] <= -30
    ):
        return "Drop"

    return "Normal"


