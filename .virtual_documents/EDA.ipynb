def detect_regional_anomaly(row):
    signals = [
        row["Same_Day_Change_pct"] < -30,
        row["Quantity_Change_pct"] < -30,
        row["Orders_Change_pct"] < -30
    ]

    if sum(signals) >= 2:
        return "Drop"
    else:
        return "Normal"
        


region_daily["Multi_Signal_Anomaly"] = region_daily.apply(
    detect_regional_anomaly,
    axis=1
)


